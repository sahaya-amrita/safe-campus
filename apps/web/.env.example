# Copy to apps/web/.env.local (git-ignored).
# API origin; the app adds /api/v1 itself. Unset = offline MOCK preview only.
VITE_API_BASE_URL=http://127.0.0.1:3000
# Show quick-fill buttons for the fictional seeded DEMO accounts (always shown in dev).
VITE_SHOW_DEMO_ACCOUNTS=false
# Supabase (browser-safe values only). The publishable key is not access control:
# Row Level Security and the API enforce permissions. Never put a secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
