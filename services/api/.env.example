NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sahaya:sahaya_local_only@localhost:55432/sahaya
TEST_DATABASE_URL=postgres://sahaya:sahaya_local_only@localhost:55432/sahaya_test
JWT_SECRET=replace-with-at-least-32-characters-local-only
JWT_ISSUER=amrita-sahaya-demo
JWT_AUDIENCE=amrita-sahaya-api
LOG_LEVEL=info
OPERATING_MODE=DEMO
OUTBOX_BATCH_SIZE=25
# In-process simulated outbox worker (dispatch + zone alert simulation). 0 disables.
OUTBOX_POLL_MS=5000
# Exact deployed frontend origins, comma-separated (localhost is allowed outside production)
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies in front of the API (e.g. 1 on Render) so rate limits see client IPs.
TRUST_PROXY=0

# --- Sign-in (Phase 2: email one-time codes) ----------------------------------
# Domains that may self-register as STUDENT (comma-separated). Existing accounts
# can sign in from any domain. Staff roles are granted only by an ADMIN.
AUTH_ALLOWED_EMAIL_DOMAINS=campus.example
# disabled | dev | resend. "dev" keeps codes in a local mailbox at
# GET /api/v1/dev/mailbox and never sends email; it is refused in production.
EMAIL_PROVIDER=dev
# For EMAIL_PROVIDER=resend (server-side only; never commit a real key):
EMAIL_FROM=
RESEND_API_KEY=
# Optional limits (defaults shown)
# OTP_TTL_SECONDS=600
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_PER_HOUR=5
# DEMO password login for local development and tests only (refused in production).
DEMO_LOGIN_ENABLED=true
# First administrator: pnpm --filter @sahaya/api admin:grant -- --email you@campus.example

# --- Phone notices (Web Push, Phase 8) ----------------------------------------
# Off unless all three VAPID values are set. Generate keys with
#   pnpm --filter @sahaya/api push:keys
# and keep the private key in the deployment's secret settings, never in git.
PUSH_PROVIDER=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:safety-team@campus.example

# --- Tom assistant -----------------------------------------------------------
# disabled | mock | groq. Keep "disabled" or "mock" unless you have a Groq key.
ASSISTANT_PROVIDER=disabled
# Server-side only. Put the real key in services/api/.env (git-ignored) or the
# hosting platform's private env settings. NEVER in the web app or VITE_*.
GROQ_API_KEY=
# A Groq model that supports strict structured outputs. Check
# https://console.groq.com/docs/structured-outputs and set it explicitly;
# the API verifies it against Groq's live model list at startup.
GROQ_MODEL=
ASSISTANT_TIMEOUT_MS=10000
ASSISTANT_RATE_LIMIT_PER_MINUTE=8
ASSISTANT_RATE_LIMIT_PER_DAY=150
ASSISTANT_PROVIDER_MAX_PER_MINUTE=25
ASSISTANT_PROVIDER_MAX_PER_DAY=900
# DEMO only: allow Tom's draft app-help content (labelled DRAFT in answers)
ASSISTANT_ALLOW_DRAFT_CONTENT=false

# Fictional local accounts created by pnpm db:seed (password login works only
# with DEMO_LOGIN_ENABLED=true outside production; they can also use email codes):
# student.demo@example.invalid / DemoStudent!2026
# verifier.demo@example.invalid / DemoVerifier!2026
# responder.demo@example.invalid / DemoResponder!2026
# admin.demo@example.invalid / DemoAdmin!2026

# --- Supabase (not used for sign-in: Phase 2 chose the API's own email codes.
# Kept for a possible hosted Postgres; see docs/v2/06-phase-roadmap.md) ---
# Use the project's Postgres connection string as DATABASE_URL once migrations
# move to Supabase. The secret key must never reach the browser or Git.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
